{
  "enabled": true,
  "virtual_models": {
    "cct/high": {
      "enabled": true,
      "description": "High quality paid model pool.",
      "strategy": "quality_first",
      "pools": ["paid_high"],
      "allow_degrade_to_low": false,
      "allow_degrade_to_free": false
    },
    "cct/low": {
      "enabled": true,
      "description": "Low cost model pool with optional free fallback.",
      "strategy": "cost_first",
      "pools": ["cheap", "local", "free"],
      "allow_degrade_to_low": false,
      "allow_degrade_to_free": true
    },
    "cct/free": {
      "enabled": true,
      "description": "Native free model pool.",
      "strategy": "free_first",
      "pools": ["free"],
      "allow_degrade_to_low": false,
      "allow_degrade_to_free": false
    }
  },
  "deployments": {
    "example-paid-high": {
      "enabled": false,
      "channel_id": 0,
      "real_model": "replace-with-paid-model",
      "pool": "paid_high",
      "quality_tier": "high",
      "cost_tier": "paid",
      "supports_vision": true,
      "supports_stream": true,
      "supports_tools": true,
      "supports_json": true,
      "context_length": 128000,
      "priority": 1,
      "weight": 100,
      "max_concurrent_requests": 5,
      "daily_limit_tokens": 0,
      "quota_mode": "paid",
      "soft_limit_ratio": 0.9,
      "hard_limit_ratio": 0.98,
      "rpm_limit": 0,
      "rpd_limit": 0,
      "tpm_limit": 0,
      "tpd_limit": 0
    },
    "example-cheap": {
      "enabled": false,
      "channel_id": 0,
      "real_model": "replace-with-cheap-model",
      "pool": "cheap",
      "quality_tier": "medium",
      "cost_tier": "cheap",
      "supports_vision": false,
      "supports_stream": true,
      "supports_tools": false,
      "supports_json": true,
      "context_length": 32000,
      "priority": 10,
      "weight": 100,
      "max_concurrent_requests": 5,
      "daily_limit_tokens": 0,
      "quota_mode": "paid",
      "soft_limit_ratio": 0.9,
      "hard_limit_ratio": 0.98,
      "rpm_limit": 0,
      "rpd_limit": 0,
      "tpm_limit": 0,
      "tpd_limit": 0
    }
  },
  "free_providers": {
    "openrouter": {
      "enabled": false,
      "keys": ["sk-or-v1-replace-me"],
      "limits_override": {
        "rpm_limit": 10,
        "rpd_limit": 500,
        "tpm_limit": 4000,
        "tpd_limit": 100000
      }
    },
    "groq": {
      "enabled": false,
      "keys": ["gsk_replace_me"],
      "models": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"],
      "limits_override": {
        "rpm_limit": 20,
        "rpd_limit": 1000,
        "tpm_limit": 6000,
        "tpd_limit": 200000
      }
    },
    "google": {
      "enabled": false,
      "keys": ["AIza-replace-me"],
      "models": ["gemini-2.0-flash-exp"],
      "limits_override": {
        "rpm_limit": 15,
        "rpd_limit": 1500
      }
    },
    "kilo": {
      "enabled": false,
      "keys": []
    },
    "pollinations": {
      "enabled": false,
      "keys": [],
      "models": ["openai-fast"],
      "limits_override": {
        "rpm_limit": 5
      }
    },
    "ovh": {
      "enabled": false,
      "keys": [],
      "models": ["gpt-oss-20b"],
      "limits_override": {
        "rpm_limit": 2
      }
    }
  },
  "alert": {
    "enabled": true,
    "check_interval_seconds": 300,
    "webhook_url": "",
    "notify_on_soft_limit": true,
    "notify_on_hard_limit": true,
    "notify_on_exhausted": true,
    "notify_on_recovered": true,
    "notify_on_all_failed": true
  },
  "smart_sort": {
    "enabled": true,
    "weights": {
      "base_priority_penalty": 5,
      "success_rate_bonus": 30,
      "error_rate_penalty": 50
    }
  },
  "blocked_error_codes": ["internal_server_error"]
}
